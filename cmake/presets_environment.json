{
	"version": 6,
	"configurePresets": [
		{
			"name": "default-config",
			"description": "Default configuration",
			"hidden": true,
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/install",
			"warnings": {
				"dev": true,
				"deprecated": true,
				"uninitialized": true,
				"unusedCli": true,
				"systemVars": false
			},
			"errors": {
				"dev": false,
				"deprecated": true
			}
		}
	],
	"buildPresets": [
		{
			"name": "default-build",
			"description": "Default build configuration",
			"hidden": true,
			"configurePreset": "default-config"
		}
	]
}
