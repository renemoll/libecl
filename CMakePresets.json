{
	"version": 6,
	"configurePresets": [
		{
			"name": "default",
			"hidden": true,
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/install"
		},
		{
			"name": "ninja",
			"hidden": true,
			"inherits": "default",
			"generator": "Ninja"
		},
		{
			"name": "debug",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "coverage",
			"hidden": true,
			"inherits": "debug",
			"cacheVariables": {
				"BOB_COVERAGE": "On"
			}
		},
		{
			"name": "ninja-debug",
			"description": "Debug build with system compiler and Ninja",
			"inherits": [
				"ninja",
				"debug"
			]
		},
		{
			"name": "ninja-coverage",
			"description": "Debug build with system compiler and Ninja for coverage analysis",
			"inherits": [
				"ninja",
				"debug",
				"coverage"
			]
		}
	],
	"buildPresets": [
		{
			"name": "ninja-debug",
			"configurePreset": "ninja-debug"
		},
		{
			"name": "ninja-coverage",
			"configurePreset": "ninja-coverage",
			"targets":[
				"common-coverage"
			]
		}
	],
	"testPresets": [
		{
			"name": "default",
			"hidden": true,
			"output": {
				"outputOnFailure": true
			},
			"execution": {
				"stopOnFailure": false,
				"scheduleRandom": true
			}
		},
		{
			"name": "coverage",
			"inherits": "default",
			"configurePreset": "ninja-coverage"
		},
		{
			"name": "unittest",
			"inherits": "default",
			"configurePreset": "ninja-debug"
		}
	],
	"workflowPresets": [
		{
			"name": "coverage",
			"steps": [
				{
					"type": "configure",
					"name": "ninja-coverage"
				},
				{
					"type": "build",
					"name": "ninja-coverage"
				}
			]
		},
		{
			"name": "unittest",
			"steps": [
				{
					"type": "configure",
					"name": "ninja-debug"
				},
				{
					"type": "build",
					"name": "ninja-debug"
				},
				{
					"type": "test",
					"name": "unittest"
				}
			]
		}
	]
}
